# Copy to .env. Never commit .env. All variables use the STUBBLEOS_ prefix (except ANTHROPIC_API_KEY).
STUBBLEOS_ENV=dev
STUBBLEOS_LOG_LEVEL=INFO
STUBBLEOS_LOG_JSON=false

STUBBLEOS_DATABASE_URL=postgresql+psycopg://stubbleos:stubbleos@localhost:5432/stubbleos
STUBBLEOS_REDIS_URL=redis://localhost:6379/0

# auto = Groq if GROQ_API_KEY is set, else Anthropic if key set, otherwise FakeLLM. Use "fake" for simulation runs.
STUBBLEOS_LLM_PROVIDER=auto
STUBBLEOS_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Required (non-default) when STUBBLEOS_ENV=prod
# STUBBLEOS_PSEUDONYM_SALT=

STUBBLEOS_CONTACT_HOURS_START=8
STUBBLEOS_CONTACT_HOURS_END=19
STUBBLEOS_WHATSAPP_ENABLED=false

STUBBLEOS_OTEL_ENABLED=false
STUBBLEOS_SIMULATION_DEFAULT_SEED=20260101
